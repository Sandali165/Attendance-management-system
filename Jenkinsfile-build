pipeline {
    agent any

    environment {
        AWS_REGION = 'eu-north-1'
        ECR_REPO = '491979259412.dkr.ecr.eu-north-1.amazonaws.com/attendance-app'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sandali165/Attendance-management-system.git'
            }
        }

        stage('Build Maven Project') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'mvn test'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat "docker build -t attendance-app:%IMAGE_TAG% ."
            }
        }

        stage('Login to AWS ECR') {
            steps {
                bat '''
                aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin 491979259412.dkr.ecr.eu-north-1.amazonaws.com
                '''
            }
        }

        stage('Tag Docker Image') {
            steps {
                bat '''
                docker tag attendance-app:%IMAGE_TAG% %ECR_REPO%:%IMAGE_TAG%
                '''
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                bat '''
                docker push %ECR_REPO%:%IMAGE_TAG%
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                bat """
                ssh -o StrictHostKeyChecking=no -i C:\\Users\\Sandali\\Downloads\\attendance-key.pem ubuntu@43.205.199.46 "aws ecr get-login-password --region eu-north-1 | sudo docker login --username AWS --password-stdin 491979259412.dkr.ecr.eu-north-1.amazonaws.com && sudo docker pull 491979259412.dkr.ecr.eu-north-1.amazonaws.com/attendance-app:${BUILD_NUMBER} && sudo docker stop attendance-container || true && sudo docker rm attendance-container || true && sudo docker run -d -p 8080:8080 --name attendance-container 491979259412.dkr.ecr.eu-north-1.amazonaws.com/attendance-app:${BUILD_NUMBER}"
                """
            }
        }
    }

    post {

        success {
            emailext(
                subject: "SUCCESS: Attendance Pipeline Build #${BUILD_NUMBER}",
                body: """
Pipeline executed successfully.

Project: ${JOB_NAME}
Build Number: ${BUILD_NUMBER}

Application deployed successfully to EC2.

Application URL:
http://43.205.199.46:8080/attendance/status
""",
                to: "altair.nevrgez@gmail.com"
            )

            echo 'Pipeline executed successfully!'
        }

        failure {
            emailext(
                subject: "FAILED: Attendance Pipeline Build #${BUILD_NUMBER}",
                body: """
Pipeline execution failed.

Project: ${JOB_NAME}
Build Number: ${BUILD_NUMBER}

Please check Jenkins console logs.
""",
                to: "altair.nevrgez@gmail.com"
            )

            echo 'Pipeline failed!'
        }
    }
}